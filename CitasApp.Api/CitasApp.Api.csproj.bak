<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.8" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\src\CitasApp.Domain\CitasApp.Domain.csproj" />
    <ProjectReference Include="..\src\CitasApp.Application\CitasApp.Application.csproj" />
    <ProjectReference Include="..\src\CitasApp.Infrastructure\CitasApp.Infrastructure.csproj" />
  </ItemGroup>


  <ItemGroup>
    <Content Update="data/**/*.json">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
    <None Update="data/**/*.json">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
