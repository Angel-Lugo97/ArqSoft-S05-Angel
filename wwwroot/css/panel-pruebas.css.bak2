* {
    box-sizing: border-box;
}

:root {
    --fondo: #12131b;
    --tarjeta: #1c1f2a;
    --tarjeta2: #222637;
    --morado: #4b1f83;
    --morado-claro: #7c3aed;
    --texto: #e7e7ee;
    --gris: #a0a4b8;
    --borde: #352450;
    --negro: #0d0f15;
    --verde: #39d47a;
    --rojo: #ff6464;
}

body {
    margin: 0;
    background: radial-gradient(circle at top left, #261640 0, var(--fondo) 360px);
    color: var(--texto);
    font-family: Arial, Helvetica, sans-serif;
}

.page {
    padding: 24px;
}

.top {
    background: linear-gradient(90deg, var(--morado), #21172f);
    border: 1px solid #5f35a1;
    border-radius: 12px;
    padding: 18px 22px;
    margin-bottom: 22px;
    display: flex;
    justify-content: space-between;
    align-items: center;
}

.top h1 {
    margin: 0;
    font-size: 26px;
    letter-spacing: 1px;
}

.top p {
    margin: 6px 0 0;
    color: #d0c9dd;
    font-size: 14px;
}

.tag {
    background: #160f22;
    border: 1px solid #7651aa;
    color: #d9c9ff;
    padding: 8px 14px;
    border-radius: 20px;
    font-size: 13px;
}

.grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(250px, 1fr));
    gap: 18px;
}

.card {
    background: linear-gradient(180deg, var(--tarjeta2), var(--tarjeta));
    border: 1px solid var(--borde);
    border-left: 5px solid var(--morado-claro);
    border-radius: 12px;
    padding: 16px;
    min-height: 310px;
    box-shadow: 0 10px 25px rgba(0, 0, 0, 0.25);
}

.card-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
    margin-bottom: 14px;
}

.card-header h2 {
    margin: 0;
    font-size: 18px;
}

.card-header span {
    background: #2c1d49;
    color: #b995ff;
    border: 1px solid #503177;
    padding: 4px 8px;
    border-radius: 8px;
    font-size: 11px;
    font-weight: bold;
}

.controls,
.botones-calculadora {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
    margin-bottom: 12px;
}

button {
    background: var(--morado-claro);
    color: white;
    border: 1px solid #9c6bff;
    border-radius: 7px;
    padding: 8px 11px;
    cursor: pointer;
    font-size: 13px;
}

button:hover {
    background: #9257ff;
}

input {
    width: 78px;
    background: #11131b;
    color: white;
    border: 1px solid #3c4053;
    border-radius: 7px;
    padding: 8px;
    outline: none;
}

input:focus {
    border-color: var(--morado-claro);
}

.status {
    font-size: 12px;
    font-weight: bold;
    color: var(--gris);
    margin-bottom: 8px;
}

.status.ok {
    color: var(--verde);
}

.status.error {
    color: var(--rojo);
}

pre {
    margin: 0;
    background: var(--negro);
    border: 1px solid #292d3b;
    color: #eeeeee;
    border-radius: 8px;
    padding: 13px;
    min-height: 145px;
    max-height: 190px;
    overflow: auto;
    font-size: 12px;
    line-height: 1.45;
    white-space: pre-wrap;
}

@media (max-width: 1200px) {
    .grid {
        grid-template-columns: repeat(2, minmax(250px, 1fr));
    }
}

@media (max-width: 650px) {
    .top {
        display: block;
    }

    .tag {
        margin-top: 12px;
        width: fit-content;
    }

    .grid {
        grid-template-columns: 1fr;
    }
}
